# ============================================================
# CharusatVote — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.
#
# Google OAuth Setup (one-time, free):
#   1. Go to https://console.cloud.google.com/
#   2. Create a new project (or use existing)
#   3. APIs & Services > OAuth consent screen > configure for Internal use
#   4. Add charusat.edu.in as an authorised domain
#   5. APIs & Services > Credentials > Create OAuth 2.0 Client ID
#   6. Application type: Web application
#   7. Authorised redirect URI: http://127.0.0.1:5000/auth/google/callback
#   8. Copy Client ID and Client Secret below
# ============================================================

GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
CHARUSAT_DOMAIN=charusat.edu.in
